    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
